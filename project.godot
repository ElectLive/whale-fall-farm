; Engine configuration file.
; Generated by hand for Whale Fall Farm.
config_version=5

[application]

config/name="鲸落农场 Whale Fall Farm"
config/version="2.1.0"
config/description="一个农场 + Roguelike 小游戏：白天种田，夜晚守夜。所有美术与音乐均由程序生成。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/generated/icon.png"
config/use_custom_user_dir=true
config/custom_user_dir_name="whale_fall_farm"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.03, 0.05, 0.1, 1)

[autoload]

Audio="*res://scripts/audio.gd"
SaveGame="*res://scripts/save_game.gd"
Dev="*res://scripts/dev.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.02, 0.04, 0.08, 1)
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true

[audio]

buses/default_bus_layout=""
